# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_voucher_db?schema=public

# JWT Credentials & Security
JWT_SECRET=supersecret_access_token_key_change_in_production_12345!
JWT_REFRESH_SECRET=supersecret_refresh_token_key_change_in_production_67890!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=cookie_secret_key_987654321

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880 # 5MB in bytes
